# Copy to .env (never commit .env). All values optional unless noted.
# MT5_AGENT_CONFIG=config/app.yaml
# MT5_AGENT_ENV=development
# MT5_AGENT_LOG_LEVEL=INFO
# MT5_AGENT_LOG_FORMAT=json
# MT5_AGENT_TRADING_MODE=dry_run
# MT5_AGENT_ENABLE_LIVE_TRADING=false
#
# --- MT5 (Phase 01: read-only connectivity; password via env only) ---
# MT5_AGENT_MT5_LOGIN=
# MT5_AGENT_MT5_PASSWORD=
# MT5_AGENT_MT5_SERVER=
# MT5_AGENT_MT5_PATH=
# MT5_AGENT_MT5_TIMEOUT_MS=60000
# MT5_AGENT_MT5_PORTABLE=false
# Set to true to run the live-terminal integration test (requires MT5 terminal):
# MT5_AGENT_RUN_LIVE_MT5_TESTS=false
#
# --- LLM (Phase 05+; keep empty until needed) ---
# MT5_AGENT_LLM_PROVIDER=none
# MT5_AGENT_LLM_MODEL=
# MT5_AGENT_LLM_API_KEY=
# MT5_AGENT_LLM_BASE_URL=
#
# --- Risk (Phase 07; YAML defaults apply; env overrides file) ---
# MT5_AGENT_RISK_MAX_RISK_PCT=1.0
# MT5_AGENT_RISK_MAX_DAILY_LOSS_PCT=3.0
# MT5_AGENT_RISK_MAX_POSITIONS=3
# MT5_AGENT_RISK_MAX_EXPOSURE=1.0
# MT5_AGENT_RISK_ALLOWED_SYMBOLS=
# MT5_AGENT_RISK_ALLOWED_SESSIONS=0-24
# MT5_AGENT_RISK_MAX_SPREAD_POINTS=
# MT5_AGENT_RISK_REQUIRE_STOP_LOSS=true
# MT5_AGENT_RISK_REQUIRE_TAKE_PROFIT=true
# MT5_AGENT_RISK_MIN_STOP_POINTS=0.0
# MT5_AGENT_RISK_DUPLICATE_WINDOW_S=600.0
# MT5_AGENT_RISK_COOLDOWN_S=60.0
# MT5_AGENT_RISK_MIN_MARGIN_LEVEL_PCT=100.0
#
# --- Execution (Phase 08; dry_run default, never live by default) ---
# MT5_AGENT_EXECUTION_MODE=dry_run
# MT5_AGENT_EXECUTION_DEFAULT_VOLUME=0.01
# MT5_AGENT_EXECUTION_MAGIC=0
# MT5_AGENT_EXECUTION_DEVIATION=20
#
# --- Memory (Phase 09; SQLite file + retention) ---
# MT5_AGENT_MEMORY_DB_PATH=data/memory.db
# MT5_AGENT_MEMORY_SHORT_TERM_KEEP=100
# MT5_AGENT_MEMORY_TRADE_KEEP=500
# MT5_AGENT_MEMORY_WORLD_KEEP=200
# MT5_AGENT_MEMORY_STRATEGY_KEEP=200
#
# --- Agent loop (Phase 10) ---
# MT5_AGENT_AGENT_SYMBOLS=EURUSD
# MT5_AGENT_AGENT_INTERVAL_S=60.0
# MT5_AGENT_AGENT_CANDLE_COUNT=50
#
# --- Dashboard (Phase 11; read-only) ---
# MT5_AGENT_DASHBOARD_HOST=127.0.0.1
# MT5_AGENT_DASHBOARD_PORT=8080
# MT5_AGENT_DASHBOARD_REFRESH_S=15
